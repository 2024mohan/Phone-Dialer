<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        signature|privileged. Requested so that, if this app is ever installed as a privileged
        system app with a privapp-permissions allow-list entry, two-way call capture works.
        For a normal (Play / sideloaded) install it is never granted, and the app detects that.
    -->
    <uses-permission
        android:name="android.permission.CAPTURE_AUDIO_OUTPUT"
        tools:ignore="ProtectedPermissions" />

    <application>
        <service
            android:name="app.minimaldialer.recording.engine.CallRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
